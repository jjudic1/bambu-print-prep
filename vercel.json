{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix web",
  "installCommand": "npm install --prefix web",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/local",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/((?!_vercel/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
